# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
FOODSAFETY_API_KEY=
ADMIN_TOKEN=
APP_NAME=recall
ENV=dev
ENABLED_CATEGORIES=food,cosmetic,consumer_product,overseas,medicine,medical_device,drinking_water,vehicle,quasi_drug,household_chemical,hygiene_product,radiation_product
COLLECT_INTERVAL_MINUTES=60
SNAPSHOT_DAYS=1095
HIDE_EMPTY_DAYS=180
IMAGE_HOST_ALLOWLIST=coop.foodsafetykorea.go.kr,www.consumer.go.kr

# 소비자24 리콜정보 OpenAPI 서비스키. 메뉴(cntntsId)마다 키가 다르다. 비어 있는 메뉴는 수집하지 않는다.
# 식품(0201)·축산물(0203)은 foodsafety_i0490과 중복이라 받지 않는다.
# 메뉴별 첫 수집은 전량, 그 뒤로는 공표일이 최근 CONSUMER24_LOOKBACK_DAYS일 안인 것만 받는다.
CONSUMER24_LOOKBACK_DAYS=30
# 0101 공산품
CONSUMER24_KEY_0101=
# 0405 생활방사선제품
CONSUMER24_KEY_0405=
# 0204 의약품
CONSUMER24_KEY_0204=
# 0205 의약외품
CONSUMER24_KEY_0205=
# 0207 의료기기
CONSUMER24_KEY_0207=
# 0206 화장품
CONSUMER24_KEY_0206=
# 0401 생활화학제품
CONSUMER24_KEY_0401=
# 0301 자동차
CONSUMER24_KEY_0301=
# 0403 먹는물
CONSUMER24_KEY_0403=
# 0208 위생용품
CONSUMER24_KEY_0208=
# 0501 해외리콜
CONSUMER24_KEY_0501=
