# 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
FOODSAFETY_API_KEY=
DATA_GO_KR_API_KEY=
ADMIN_TOKEN=
APP_NAME=recall-check
ENV=dev
ENABLED_CATEGORIES=food,cosmetic,consumer_product,overseas,medicine,medical_device,drinking_water
COLLECT_INTERVAL_MINUTES=60
SNAPSHOT_DAYS=1095
HIDE_EMPTY_DAYS=180
IMAGE_HOST_ALLOWLIST=coop.foodsafetykorea.go.kr

# 명세 확정 전인 수집기 (비워 둔다)
KATS_API_URL=
FTC_API_URL=
MFDS_COSMETIC_API_URL=
